# ==============================================================================
# YouthFit AI Environment Variables Template
# Copy this file to .env and replace the placeholder values with your real keys.
# ==============================================================================

# Gemini AI API Key (Required for LLM Deep Diagnosis)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 온통청년 Open API Key (Required for Policy Data Sync & Live Fetch)
# Get your key at: https://www.youthcenter.go.kr
ONTONG_API_KEY=your_ontong_api_key_here

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# Option 1: Full Connection URL (Recommended for Docker, Supabase, Neon, AWS RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youthfit

# Option 2: Individual Connection Parameters (Alternative)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=youthfit
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

